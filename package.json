{
  "name": "secure-messaging-app",
  "version": "1.0.0",
  "description": "A secure messaging web application with USID-based identity and Signal protocol encryption",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "node --test tests/*.test.js",
    "test:x25519": "node --test tests/x25519_protocol.test.js tests/x3dh.test.js tests/double_ratchet.test.js",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:cold": "node scripts/benchmark.js --suite cold-start",
    "postinstall": "npm rebuild sqlite3"
  },
  "dependencies": {
    "crypto": "^1.0.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.2.1",
    "sqlite3": "^6.0.1",
    "webtorrent": "^2.4.3",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "messaging",
    "security",
    "usid",
    "signal-protocol"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.17.0"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
